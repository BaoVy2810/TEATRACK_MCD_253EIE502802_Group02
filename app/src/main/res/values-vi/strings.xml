    <!-- About Us -->
    <string name="about_hero_eyebrow">Hồng trà Ngô gia</string>
    <string name="about_hero_title">Tự hào 74 năm hình thành và phát triển</string>
    <string name="about_story_title">CÂU CHUYỆN THƯƠNG HIỆU</string>
    <string name="about_story_desc">Năm 1951, giữa đất trà mộc mạc, thương hiệu ra đời với đam mê tạo nên những ly trà đậm vị. Từ đó, Ngô Gia đã trở thành một trong những thương hiệu trà được yêu thích nhờ chất lượng ổn định, dịch vụ tận tâm và không ngừng đổi mới để bắt kịp xu hướng của giới trẻ Việt.</string>
    <string name="about_feature_quality_title">Chất lượng hàng đầu</string>
    <string name="about_feature_quality_desc">An toàn, vệ sinh và ngon miệng. Việc sử dụng các nguyên liệu an toàn, tự nhiên và vệ sinh là ưu tiên hàng đầu của Hồng trà Ngô Gia.</string>
    <string name="about_feature_service_title">Dịch vụ tận tâm</string>
    <string name="about_feature_service_desc">Hồng trà Ngô Gia mong muốn làm hài lòng khách hàng tốt nhất với tác phong phục vụ chuyên nghiệp và thân thiện.</string>
    <string name="about_feature_tradition_title">Truyền thống &amp; sáng tạo</string>
    <string name="about_feature_tradition_desc">Dựa trên hai nền tảng cốt lõi là Chất Lượng và Dịch Vụ, Hồng trà Ngô gia luôn nỗ lực xây dựng thương hiệu đáng tin cậy.</string>
    <string name="about_video_overlay">HỒNG TRÀ NGÔ GIA</string>
    <string name="about_mission_title">SỨ MỆNH CỦA CHÚNG TÔI</string>
    <string name="about_mission_desc">Hồng Trà Ngô Gia cam kết mang đến những thức uống tinh tế, lành mạnh và an toàn cho sức khỏe. Mỗi ly trà là tâm huyết của người làm nghề, gửi gắm niềm tự hào Việt.</string>
    <string name="about_vision_title">TẦM NHÌN THƯƠNG HIỆU</string>
    <string name="about_vision_desc">Trở thành thương hiệu tiên phong trong lĩnh vực đồ uống chất lượng cao tại Việt Nam, được người tiêu dùng tin cậy và yêu mến. Ngô Gia hướng đến phát triển bền vững.</string>
    <string name="about_customer_centric_title">KHÁCH HÀNG LÀ TRỌNG TÂM</string>
    <string name="about_customer_centric_desc">Hồng Trà Ngô Gia luôn lắng nghe, thấu hiểu và không ngừng hoàn thiện để mang đến trải nghiệm trà tốt nhất cho bạn. Mỗi ly trà được pha không chỉ bằng hương vị tinh tế, mà còn bằng sự trân trọng và tận tâm dành cho từng vị khách.</string>
