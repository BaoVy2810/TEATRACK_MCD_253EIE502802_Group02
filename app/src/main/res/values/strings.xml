    <string name="about_vision_banner_content_desc">Ngo Gia vision statement visual</string>
    <string name="about_vision_title">BRAND VISION</string>
    <string name="about_vision_desc">To become the pioneer leading brand in premium tea industry across Vietnam market, gaining total trust from consumers through absolute transparency regarding raw ingredient supplies&#8230;</string>
