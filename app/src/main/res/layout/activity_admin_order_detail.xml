<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_baby_blue"
    tools:context="com.teatrack_mcd_253eie502802_group02.admin.AdminOrderDetailActivity">

    <include
        android:id="@+id/headerBar"
        layout="@layout/layout_client_subpage_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Order header card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#EFF6FF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivAdminOrderThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@mipmap/logo_ngo_gia" />

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvAdminOrderId"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter_semibold"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="#HTNG-70969" />

                                <TextView
                                    android:id="@+id/tvAdminStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    tools:background="@drawable/bg_status_pending"
                                    tools:text="Pending" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAdminOrderDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="25 Jun 2026 • 08:14 AM" />

                            <TextView
                                android:id="@+id/tvAdminPaymentChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_payment_chip"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="3dp"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="Cash on hand" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="#F3F4F6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_family"
                                android:letterSpacing="0.08"
                                android:text="@string/admin_label_items"
                                android:textColor="@color/secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminItemCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="3 items" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:background="#E5E7EB" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_family"
                                android:letterSpacing="0.08"
                                android:text="@string/admin_label_total"
                                android:textColor="@color/secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="@color/brand_blue"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="64.000đ" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Order progress -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_family"
                android:letterSpacing="0.08"
                android:text="@string/admin_order_progress_title"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/stepCircleRow"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="0.5" />

                            <FrameLayout
                                android:id="@+id/stepCircle1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg1"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/pending"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/brand_blue"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg2"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/processing"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/brand_blue"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg3"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ready"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/brand_blue"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg4"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/shipping"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/brand_blue"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg5"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/finished"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="0.5" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/stepCircleRow"
                            android:layout_marginTop="4dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/stepLabel1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_pending"
                                android:textColor="#999999"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/stepLabel2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_processing"
                                android:textColor="#999999"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/stepLabel3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_ready"
                                android:textColor="#999999"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/stepLabel4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_shipping"
                                android:textColor="#999999"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/stepLabel5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_completed"
                                android:textColor="#999999"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </RelativeLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Order items -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_family"
                android:letterSpacing="0.08"
                android:text="@string/str_section_order_items"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llAdminOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Delivery / customer information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_family"
                android:letterSpacing="0.08"
                android:text="@string/str_section_delivery_info"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_customer_name" />
                        <TextView
                            android:id="@+id/tvDeliveryName"
                            style="@style/OrderDetailInfoValue"
                            tools:text="Nguyễn Hoàng Đức" />
                    </LinearLayout>

                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_phone_number" />
                        <TextView
                            android:id="@+id/tvDeliveryPhone"
                            style="@style/OrderDetailInfoValue"
                            tools:text="033 643 349" />
                    </LinearLayout>

                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_delivery_address" />
                        <TextView
                            android:id="@+id/tvDeliveryAddress"
                            style="@style/OrderDetailInfoValue"
                            android:ellipsize="none"
                            android:maxLines="4"
                            tools:text="CN Linh Xuân - Thủ Đức&#10;244 Đường Số 8, Linh Xuân, Thủ Đức, HCMC" />
                    </LinearLayout>

                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/col_branch_address" />
                        <TextView
                            android:id="@+id/tvDeliveryBranch"
                            style="@style/OrderDetailInfoValue"
                            android:ellipsize="none"
                            android:maxLines="4"
                            tools:text="H071 - 244 Duong So 8" />
                    </LinearLayout>

                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_payment_method" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/tvDeliveryPayment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:background="@drawable/bg_payment_momo"
                                tools:text="MoMo" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_order_status" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/tvDeliveryStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:background="@drawable/bg_status_pending"
                                tools:text="Pending" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Payment summary -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="@string/cart_subtotal"
                            android:textColor="@color/secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaySubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="@string/cart_delivery_fee"
                            android:textColor="@color/secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayShipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llDiscountRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="@string/cart_voucher"
                            android:textColor="@color/secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:textColor="@color/phone_green"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:fontWeight="800"
                            android:text="@string/cart_total"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:fontWeight="800"
                            android:textColor="@color/brand_blue"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Admin actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminUpdateStatus"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_family"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:text="@string/btn_admin_update_status_label"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/brand_blue"
                    app:cornerRadius="12dp"
                    app:elevation="2dp"
                    app:icon="@drawable/edit_1"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminDeleteOrder"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_family"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:text="@string/btn_admin_delete_order"
                    android:textAllCaps="false"
                    android:textColor="@color/danger"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/trash_can"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/danger"
                    app:strokeColor="@color/danger"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
