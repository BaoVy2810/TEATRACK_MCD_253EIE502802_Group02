<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#0F000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Ảnh bài viết khung vuông, bo góc -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgBlogThumbnail"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage8dp"
            tools:src="@drawable/ic_launcher_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <!-- Ngày tháng (Lấy từ Firebase) -->
            <TextView
                android:id="@+id/txtBlogDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#808080"
                android:textSize="7sp"
                android:fontFamily="@font/inter_semibold"
                tools:text="Ngày cập nhật"
                android:layout_marginBottom="2dp" />

            <!-- Divider mờ -->
            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginBottom="4dp" />

            <!-- Tiêu đề (Lấy từ Firebase) -->
            <TextView
                android:id="@+id/txtBlogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_blue"
                android:textSize="10sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                tools:text="Tiêu đề bài viết từ Firebase" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>