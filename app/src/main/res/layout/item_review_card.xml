<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_review_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReviewInitial"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_brand_blue"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="N" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReviewUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_family"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Nguyễn Ba Đủ" />

            <LinearLayout
                android:id="@+id/layoutReviewCardStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_review_date_chip"
            android:fontFamily="@font/inter_family"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/nav_inactive"
            android:textSize="10sp"
            tools:text="25/03/2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReviewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_family"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Perfect sweetness"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="@color/brand_blue" />

        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_family"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="&quot;Sữa tươi rất thơm, khoai môn bùi và ngọt vừa phải.&quot;" />
    </LinearLayout>
</LinearLayout>
