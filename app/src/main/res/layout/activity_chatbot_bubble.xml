<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDimOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">
    <LinearLayout
        android:id="@+id/chatCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_chat_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">
        <!--  Header  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_chat_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="🫖"
                android:textSize="18sp"
                android:gravity="center"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Bạn cần giúp gì nào?"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <ImageButton
                android:id="@+id/btnCloseChatbot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF"/>
        </LinearLayout>
        <!--  Messages  -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatMessages"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="none"/>
        <!--  Divider  -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"/>
        <!--  Input Bar  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="NOGA giúp được gì cho bạn lứ nè?"
                android:textSize="13sp"
                android:textColorHint="#AAAAAA"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:imeOptions="actionSend"
                android:maxLines="1"/>
            <ImageButton
                android:id="@+id/btnSendMessage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_button"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF"
                android:contentDescription="Gửi"
                android:padding="10dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>