<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--HERO-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hồng trà Ngô gia"
                    android:textColor="#0088FF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tự hào 74 năm hình thành và phát triển"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivHeroLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Logo Hồng Trà Ngô Gia"
                android:scaleType="fitCenter"
                android:src="@mipmap/logo_ngo_gia" />
        </LinearLayout>

        <!--STORY-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CÂU CHUYỆN THƯƠNG HIỆU"
                android:textColor="#D11515"
                android:textSize="10sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Năm 1951, giữa đất trà mộc mạc, thương hiệu ra đời với đam mê tạo nên những ly trà đậm vị. Từ đó, Ngô Gia đã trở thành một trong những thương hiệu trà được yêu thích nhờ chất lượng ổn định, dịch vụ tận tâm và không ngừng đổi mới để bắt kịp xu hướng của giới trẻ Việt."
                android:textColor="#475569"
                android:textSize="7sp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.7" />

            <!-- Feature Card 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@mipmap/ic_leaf"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Chất lượng" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chất lượng hàng đầu"
                            android:textColor="#D11515"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="An toàn, vệ sinh và ngon miệng. Việc sử dụng các nguyên liệu an toàn, tự nhiên và vệ sinh là ưu tiên hàng đầu của Hồng trà Ngô Gia."
                            android:textColor="#64748B"
                            android:textSize="7sp"
                            android:fontFamily="@font/inter_semibold"
                            android:lineSpacingMultiplier="1.6" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Feature Card 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@mipmap/ic_heart"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Dịch vụ" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dịch vụ tận tâm"
                            android:textColor="#D11515"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Hồng trà Ngô Gia mong muốn làm hài lòng khách hàng tốt nhất với tác phong phục vụ chuyên nghiệp và thân thiện."
                            android:textColor="#64748B"
                            android:textSize="7sp"
                            android:fontFamily="@font/inter_semibold"
                            android:lineSpacingMultiplier="1.6" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Feature Card 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@mipmap/ic_star"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Truyền thống" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Truyền thống &amp; sáng tạo"
                            android:textColor="#D11515"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dựa trên hai nền tảng cốt lõi là Chất Lượng và Dịch Vụ, Hồng trà Ngô gia luôn nỗ lực xây dựng thương hiệu đáng tin cậy."
                            android:textColor="#64748B"
                            android:textSize="7sp"
                            android:fontFamily="@font/inter_semibold"
                            android:lineSpacingMultiplier="1.6" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!--VIDEO-->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp">

            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#44000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HỒNG TRÀ NGÔ GIA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <!--MISSION-->
        <FrameLayout
            android:id="@+id/sectionMission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/ivMissionBanner"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@mipmap/banner_aboutus"
                android:scaleType="centerCrop"
                android:contentDescription="Sứ mệnh Ngô Gia" />

            <LinearLayout
                android:id="@+id/missionOverlay"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="#B0000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SỨ MỆNH CỦA CHÚNG TÔI"
                    android:textColor="#FFF8E9"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:background="#FFF8E9"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hồng Trà Ngô Gia cam kết mang đến những thức uống tinh tế, lành mạnh và an toàn cho sức khỏe. Mỗi ly trà là tâm huyết của người làm nghề, gửi gắm niềm tự hào Việt."
                    android:textColor="#FFF8E9"
                    android:textSize="7sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.8" />
            </LinearLayout>
        </FrameLayout>

        <!-- VISION-->
        <FrameLayout
            android:id="@+id/sectionVision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivVisionBanner"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@mipmap/banner_aboutus2"
                android:scaleType="centerCrop"
                android:contentDescription="Tầm nhìn thương hiệu" />

            <LinearLayout
                android:id="@+id/visionOverlay"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="#99020617">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TẦM NHÌN THƯƠNG HIỆU"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:background="#FFF8E9"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trở thành thương hiệu tiên phong trong lĩnh vực đồ uống chất lượng cao tại Việt Nam, được người tiêu dùng tin cậy và yêu mến. Ngô Gia hướng đến phát triển bền vững."
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.7" />
            </LinearLayout>
        </FrameLayout>

        <!-- DRINKS MOSAIC (HorizontalScrollView)-->
        <FrameLayout
            android:id="@+id/sectionMosaic"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="#AEE0FF"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!--Col 1 - odd -->
            <LinearLayout
                android:id="@+id/mosaicCol1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:translationX="0dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_1"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_3"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
            </LinearLayout>

            <!--Col 2 - even -->
            <LinearLayout
                android:id="@+id/mosaicCol2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="82dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_2"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_4"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
            </LinearLayout>

            <!--Col 3 - odd -->
            <LinearLayout
                android:id="@+id/mosaicCol3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="164dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_5"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_1"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
            </LinearLayout>

            <!--Col 4 - even -->
            <LinearLayout
                android:id="@+id/mosaicCol4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="246dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_3"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_5"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
            </LinearLayout>

            <!--Col 5 - odd -->
            <LinearLayout
                android:id="@+id/mosaicCol5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="328dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_2"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_4"
                    android:scaleType="centerCrop"
                    android:contentDescription="drink"/>
            </LinearLayout>
        </FrameLayout>

        <!---->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@mipmap/back"
                android:scaleType="centerCrop"
                android:alpha="0.5"
                android:contentDescription="background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KHÁCH HÀNG LÀ TRỌNG TÂM"
                    android:textColor="#D11515"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hồng Trà Ngô Gia luôn lắng nghe, thấu hiểu và không ngừng hoàn thiện để mang đến trải nghiệm trà tốt nhất cho bạn. Mỗi ly trà được pha không chỉ bằng hương vị tinh tế, mà còn bằng sự trân trọng và tận tâm dành cho từng vị khách."
                    android:textColor="#374151"
                    android:textSize="7sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6" />
            </LinearLayout>
        </FrameLayout>

        <!-- GREETING BANNER-->
        <FrameLayout
            android:id="@+id/sectionGreet"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#EDF3FF">

            <TextView
                android:id="@+id/tvGreetGhostTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:translationY="-22dp"
                android:text="NGÔ GIA XIN CHÀO   NGÔ GIA XIN CHÀO   NGÔ GIA XIN CHÀO"
                android:textColor="#1A163557"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true" />
            <TextView
                android:id="@+id/tvGreetGhostBot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:translationY="22dp"
                android:text="NGÔ GIA XIN CHÀO   NGÔ GIA XIN CHÀO   NGÔ GIA XIN CHÀO"
                android:textColor="#1A163557"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true" />
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="NGÔ GIA XIN CHÀO"
                android:textColor="#0088FF"
                android:textSize="20sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:gravity="center" />

        </FrameLayout>
    </LinearLayout>
</ScrollView>