<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/header"
        layout="@layout/activity_header_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/nav_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!--HERO-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:orientation="horizontal"
            android:padding="24dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_hero_eyebrow"
                    android:textColor="#0088FF"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/about_hero_title"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivHeroLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/about_hero_eyebrow"
                android:scaleType="fitCenter"
                android:src="@mipmap/logo_ngo_gia" />
        </LinearLayout>

        <!--STORY-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_story_title"
                android:textColor="#D11515"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/about_story_desc"
                android:textColor="#475569"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.7" />

            <!-- Feature Card 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@mipmap/ic_leaf"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/about_feature_quality_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/about_feature_quality_title"
                            android:textColor="#D11515"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_feature_quality_desc"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:lineSpacingMultiplier="1.6" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Feature Card 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@mipmap/ic_heart"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/about_feature_service_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/about_feature_service_title"
                            android:textColor="#D11515"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_feature_service_desc"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:lineSpacingMultiplier="1.6" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Feature Card 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@mipmap/ic_star"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/about_feature_tradition_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/about_feature_tradition_title"
                            android:textColor="#D11515"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_feature_tradition_desc"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:lineSpacingMultiplier="1.6" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!--VIDEO-->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="4dp">

            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#44000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_video_overlay"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <!--MISSION-->
        <FrameLayout
            android:id="@+id/sectionMission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/ivMissionBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@mipmap/banner_aboutus"
                android:scaleType="centerCrop"
                android:contentDescription="@string/about_mission_title" />

            <LinearLayout
                android:id="@+id/missionOverlay"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#B0000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mission_title"
                    android:textColor="#FFF8E9"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="#FFF8E9"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mission_desc"
                    android:textColor="#FFF8E9"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.8" />
            </LinearLayout>
        </FrameLayout>

        <!-- VISION-->
        <FrameLayout
            android:id="@+id/sectionVision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">

            <ImageView
                android:id="@+id/ivVisionBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@mipmap/banner_aboutus2"
                android:scaleType="centerCrop"
                android:contentDescription="@string/about_vision_title" />

            <LinearLayout
                android:id="@+id/visionOverlay"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#99020617">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_vision_title"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="#FFF8E9"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_vision_desc"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.7" />
            </LinearLayout>
        </FrameLayout>

        <!-- DRINKS MOSAIC (HorizontalScrollView)-->
        <FrameLayout
            android:id="@+id/sectionMosaic"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:background="#EDF3FF"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!--Col 1 - odd -->
            <LinearLayout
                android:id="@+id/mosaicCol1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:translationX="0dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_1"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_3"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
            </LinearLayout>

            <!--Col 2 - even -->
            <LinearLayout
                android:id="@+id/mosaicCol2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="82dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_2"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_4"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
            </LinearLayout>

            <!--Col 3 - odd -->
            <LinearLayout
                android:id="@+id/mosaicCol3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="164dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_5"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_1"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
            </LinearLayout>

            <!--Col 4 - even -->
            <LinearLayout
                android:id="@+id/mosaicCol4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="246dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_3"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_5"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
            </LinearLayout>

            <!--Col 5 - odd -->
            <LinearLayout
                android:id="@+id/mosaicCol5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:translationX="328dp">
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="6dp"
                    android:src="@mipmap/drink_2"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
                <ImageView
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:src="@mipmap/drink_4"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/about_drink_desc"/>
            </LinearLayout>
        </FrameLayout>

        <!---->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@mipmap/back"
                android:scaleType="centerCrop"
                android:alpha="0.5"
                android:contentDescription="@string/about_customer_centric_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_customer_centric_title"
                    android:textColor="#D11515"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/about_customer_centric_desc"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6" />
            </LinearLayout>
        </FrameLayout>

        <!-- GREETING BANNER-->
        <FrameLayout
            android:id="@+id/sectionGreet"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#EDF3FF">

            <TextView
                android:id="@+id/tvGreetGhostTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:translationY="-22dp"
                android:text="@string/about_greeting_marquee"
                android:textColor="#1A163557"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true" />
            <TextView
                android:id="@+id/tvGreetGhostBot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:translationY="22dp"
                android:text="@string/about_greeting_marquee"
                android:textColor="#1A163557"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true" />
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/about_greeting"
                android:textColor="#0088FF"
                android:textSize="20sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:gravity="center" />

            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/nav_bar"
        layout="@layout/activity_nav_bar_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
