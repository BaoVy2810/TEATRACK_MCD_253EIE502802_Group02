<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.AboutUsActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="@dimen/header_elevation"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomRounded">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_arrow_circle"
                android:contentDescription="@string/product_detail_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_blue" />

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:text="@string/about_page_title"
                android:textColor="@color/brand_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnShare"
                app:layout_constraintStart_toEndOf="@+id/btnBack"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_arrow_circle"
                android:contentDescription="@string/blog_detail_share"
                android:padding="8dp"
                android:src="@drawable/share"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_blue" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHeroEyebrowPrefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:paddingEnd="5dp"
                            android:text="@string/about_hero_eyebrow_prefix"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroEyebrowHighlight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="@string/about_hero_eyebrow_highlight"
                            android:textColor="#0088FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/about_hero_title"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivHeroLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/about_logo_content_desc"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/logo_ngo_gia" />
            </LinearLayout>

            <!-- CÂU CHUYỆN THƯƠNG HIỆU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_story_title"
                    android:textColor="#D11515"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:justificationMode="inter_word"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/about_story_desc"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <!-- CARD 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_leaf"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/about_feature_quality_content_desc" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_feature_quality_title"
                                android:textColor="#D11515"
                                android:textSize="15sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_semibold"
                                android:justificationMode="inter_word"
                                android:lineSpacingMultiplier="1.4"
                                android:text="@string/about_feature_quality_desc"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_heart"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/about_feature_service_content_desc" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_feature_service_title"
                                android:textColor="#D11515"
                                android:textSize="15sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_semibold"
                                android:justificationMode="inter_word"
                                android:lineSpacingMultiplier="1.4"
                                android:text="@string/about_feature_service_desc"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_star"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/about_feature_tradition_content_desc" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_feature_tradition_title"
                                android:textColor="#D11515"
                                android:textSize="15sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_semibold"
                                android:justificationMode="inter_word"
                                android:lineSpacingMultiplier="1.4"
                                android:text="@string/about_feature_tradition_desc"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- VIDEO VIEW CONTAINER -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:id="@+id/videoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="205dp"
                    android:background="#000000"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <TextureView
                        android:id="@+id/videoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- SỨ MỆNH -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sectionMission"
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivMissionBanner"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/about_mission_banner_content_desc"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/banner_aboutus"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/RoundedImage12dp" />

                    <LinearLayout
                        android:id="@+id/missionOverlay"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_about_mission_panel"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.78">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:gravity="center_horizontal"
                            android:text="@string/about_mission_title"
                            android:textColor="#FFF8E9"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="3dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="#FFF8E9" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:justificationMode="inter_word"
                            android:lineSpacingMultiplier="1.45"
                            android:text="@string/about_mission_desc"
                            android:textColor="#FFF8E9"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- TẦM NHÌN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <FrameLayout
                    android:id="@+id/sectionVision"
                    android:layout_width="match_parent"
                    android:layout_height="280dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivVisionBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/about_vision_banner_content_desc"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/banner_aboutus2"
                        app:shapeAppearanceOverlay="@style/RoundedImage12dp" />

                    <LinearLayout
                        android:id="@+id/visionOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_about_vision_panel"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:text="@string/about_vision_title"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="8dp"
                            android:background="#FFF8E9" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:justificationMode="inter_word"
                            android:lineSpacingMultiplier="1.45"
                            android:text="@string/about_vision_desc"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- MOSAIC: 5 ảnh drink_2 → drink_5 -->
            <FrameLayout
                android:id="@+id/sectionMosaic"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="20dp"
                android:background="#AEE0FF"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:padding="22dp">

                <LinearLayout
                    android:id="@+id/mosaicGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.9"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/mosaicCell1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:clipChildren="true"
                        android:clipToPadding="true">

                        <ImageView
                            android:id="@+id/mosaicImg1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/about_drink_content_desc"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/drink_2" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mosaicCell2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:translationY="14dp">

                        <ImageView
                            android:id="@+id/mosaicImg2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/about_drink_content_desc"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/drink_1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mosaicCell3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:clipChildren="true"
                        android:clipToPadding="true">

                        <ImageView
                            android:id="@+id/mosaicImg3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/about_drink_content_desc"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/drink_3" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mosaicCell4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:translationY="14dp">

                        <ImageView
                            android:id="@+id/mosaicImg4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/about_drink_content_desc"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/drink_4" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mosaicCell5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:clipChildren="true"
                        android:clipToPadding="true">

                        <ImageView
                            android:id="@+id/mosaicImg5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/about_drink_content_desc"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/drink_5" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- KHÁCH HÀNG LÀ TRỌNG TÂM -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:alpha="0.3"
                    android:contentDescription="@string/about_background_content_desc"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/back" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_customer_centric_title"
                        android:textColor="#D11515"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:justificationMode="inter_word"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/about_customer_centric_desc"
                        android:textColor="#374151"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- GREETING BANNER -->
            <FrameLayout
                android:id="@+id/sectionGreet"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_about_greet"
                android:clipChildren="true"
                android:clipToPadding="true">

                <com.teatrack_mcd_253eie502802_group02.shared.ui.StrokeTextView
                    android:id="@+id/tvGreetGhostTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="52dp"
                    android:ellipsize="none"
                    android:fontFamily="@font/inter_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:singleLine="true"
                    android:text="@string/about_greeting_marquee"
                    android:textAllCaps="true"
                    android:textColor="@android:color/transparent"
                    android:textSize="28sp"
                    app:strokeColor="#1F163557"
                    app:strokeWidthDp="1.1dp" />

                <com.teatrack_mcd_253eie502802_group02.shared.ui.StrokeTextView
                    android:id="@+id/tvGreetGhostBot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="52dp"
                    android:ellipsize="none"
                    android:fontFamily="@font/inter_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:singleLine="true"
                    android:text="@string/about_greeting_marquee"
                    android:textAllCaps="true"
                    android:textColor="@android:color/transparent"
                    android:textSize="28sp"
                    app:strokeColor="#1F163557"
                    app:strokeWidthDp="1.1dp" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:ellipsize="none"
                        android:fontFamily="@font/inter_family"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/about_greeting"
                        android:textAllCaps="true"
                        android:textColor="#0088ff"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>