<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_blog_detail"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.BlogDetail">

    <include
        android:id="@+id/header"
        layout="@layout/activity_header_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/nav_bar"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Breadcrumb Banner -->
            <LinearLayout
                android:id="@+id/breadcrumb_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D4EDFC"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="24dp"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/txtDetailBreadcrumbTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#0B1320"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Blog Title" />

                <TextView
                    android:id="@+id/txtBreadcrumbPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="@string/blog_detail_breadcrumb_path"
                    android:textColor="#666666"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Ngày đăng -->
                <TextView
                    android:id="@+id/txtDetailDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    tools:text="09/10/2023" />

                <!-- Heading -->
                <TextView
                    android:id="@+id/txtDetailHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="#224b61"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="KEM CHEESE &amp; XÍ MUỘI - BỘ ĐÔI KHUẤY ĐẢO" />

                <!-- Subheading -->
                <TextView
                    android:id="@+id/txtDetailSubheading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="#4A6B82"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:visibility="gone"
                    tools:text="Subheading text here"
                    tools:visibility="visible" />

                <!-- Divider with Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1.5dp"
                        android:background="#D1D5DB" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="16dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/logo_ngo_gia" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1.5dp"
                        android:background="#D1D5DB" />
                </LinearLayout>

                <!-- Single Image -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgDetailSingle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:shapeAppearanceOverlay="@style/RoundedImage8dp"
                    android:visibility="gone"
                    android:contentDescription="@string/blog_detail_image_desc"
                    tools:src="@drawable/ic_launcher_background"
                    tools:visibility="visible" />

                <!-- Gallery Layout -->
                <LinearLayout
                    android:id="@+id/layoutDetailGallery"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgGalleryLeft"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/RoundedImage8dp"
                        android:contentDescription="@string/blog_detail_image_desc" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgGalleryRight1"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedImage8dp"
                            android:contentDescription="@string/blog_detail_image_desc" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgGalleryRight2"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedImage8dp"
                            android:contentDescription="@string/blog_detail_image_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Blog Content -->
                <TextView
                    android:id="@+id/txtDetailContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:lineSpacingMultiplier="1.6"
                    android:paddingHorizontal="4dp"
                    android:textColor="#4B5563"
                    android:textSize="15sp"
                    android:justificationMode="inter_word"
                    tools:text="Nội dung bài viết sẽ hiển thị ở đây với định dạng văn bản được căn đều hai bên, tạo cảm giác chuyên nghiệp và dễ đọc như trên website..." />

            </LinearLayout>

            <!-- Related Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/blog_detail_related_title"
                    android:textColor="#0088FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRelatedBlogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="24dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_related_blog" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/nav_bar"
        layout="@layout/activity_nav_bar_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>