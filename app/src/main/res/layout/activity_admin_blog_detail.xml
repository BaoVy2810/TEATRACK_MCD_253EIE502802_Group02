<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_baby_blue"
    tools:context="com.teatrack_mcd_253eie502802_group02.admin.AdminBlogDetail">

    <include
        android:id="@+id/headerBar"
        layout="@layout/layout_client_subpage_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.5"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@mipmap/nen" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_blog_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="40dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/tvAdminBlogDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="#888888"
                            android:textSize="14sp"
                            tools:text="09/10/2023" />

                        <TextView
                            android:id="@+id/tvAdminBlogStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvAdminBlogTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="#224b61"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="KEM CHEESE &amp; XI MUOI - BO DOI KHUAY DAO" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="20dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="80dp"
                                android:layout_height="1.5dp"
                                android:background="#D1D5DB" />

                            <ImageView
                                android:layout_width="77dp"
                                android:layout_height="48dp"
                                android:layout_marginHorizontal="16dp"
                                android:contentDescription="@string/app_name"
                                android:scaleType="fitCenter"
                                android:src="@mipmap/logo_ngo_gia" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="1.5dp"
                                android:background="#D1D5DB" />
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAdminBlogImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/blog_detail_image_desc"
                            android:scaleType="fitCenter"
                            app:shapeAppearanceOverlay="@style/RoundedImage8dp"
                            tools:src="@drawable/ic_launcher_background" />

                        <TextView
                            android:id="@+id/tvAdminBlogContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:justificationMode="inter_word"
                            android:lineSpacingMultiplier="1.6"
                            android:paddingHorizontal="4dp"
                            android:textColor="#4B5563"
                            android:textSize="12sp"
                            tools:text="Noi dung bai viet se hien thi o day voi dinh dang van ban duoc can deu hai ben." />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
