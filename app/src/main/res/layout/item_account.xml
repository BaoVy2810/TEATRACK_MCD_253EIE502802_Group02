<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/account_card_radius"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== HEADER ===== -->
        <!--
            [Avatar]  [CS01]  [Tên]         [Nâng VIP]
                      [@username]            [  Xóa   ]
                      [email@...]
            (badge Active góc trên-phải tuyệt đối)
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Avatar -->
            <TextView
                android:id="@+id/tvInitial"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_circle_brand_blue"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/avatar_text_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="T" />

            <!-- Badge Active — góc phải trên -->
            <TextView
                android:id="@+id/tvStatus"
                style="@style/Widget.TeaTrack.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Active" />

            <!-- Nút Nâng VIP / Hạ cấp — nằm sát phải, bên dưới badge Active -->
            <LinearLayout
                android:id="@+id/layoutVipDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:gravity="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStatus">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpgradeVip"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/vip_button_height"
                    android:minWidth="0dp"
                    android:minHeight="@dimen/vip_button_height"
                    android:paddingHorizontal="8dp"
                    android:text="@string/btn_upgrade_vip"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textColor="@color/vip_purple"
                    android:textSize="@dimen/vip_button_text_size"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_crown"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="@dimen/vip_icon_size"
                    app:iconTint="@color/vip_purple"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="@color/vip_purple_light"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- Account ID badge -->
            <TextView
                android:id="@+id/tvAccountId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_account_id_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/brand_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/tvInitial"
                app:layout_constraintTop_toTopOf="@id/tvInitial"
                tools:text="CS01" />

            <!-- Tên — chiều rộng đến sát layoutVipDelete -->
            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/layoutVipDelete"
                app:layout_constraintStart_toEndOf="@id/tvInitial"
                app:layout_constraintTop_toBottomOf="@id/tvAccountId"
                tools:text="Nguyen Thanh Long" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/layoutVipDelete"
                app:layout_constraintStart_toEndOf="@id/tvInitial"
                app:layout_constraintTop_toBottomOf="@id/tvFullName"
                tools:text="@thanh2603" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvInitial"
                app:layout_constraintTop_toBottomOf="@id/tvUsername"
                tools:text="thanhtr234112e@st.uel.edu" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider" />

        <!-- ===== VAI TRÒ + SĐT — 2 cột đủ rộng, 10 số không bị xuống hàng ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tvRoleIcon"
                    android:layout_width="@dimen/role_icon_size"
                    android:layout_height="@dimen/role_icon_size"
                    android:contentDescription="@string/cd_role"
                    android:padding="@dimen/sp_2"
                    android:src="@drawable/ic_crown"
                    app:tint="@color/brand_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_role"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/label_text_size" />

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/detail_value_text_size"
                        tools:text="Customer" />

                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/role_icon_size"
                    android:layout_height="@dimen/role_icon_size"
                    android:contentDescription="@string/cd_phone"
                    android:src="@drawable/call"
                    app:tint="@color/phone_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_phone_account"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/label_text_size" />

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/detail_value_text_size"
                        tools:text="0952643575" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ===== ĐỊA CHỈ — hàng riêng full width, thoải mái hiện địa chỉ dài ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/role_icon_size"
                android:layout_height="@dimen/role_icon_size"
                android:contentDescription="@string/cd_address"
                android:src="@drawable/location"
                app:tint="@color/address_amber" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_address_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/label_text_size" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/detail_value_text_size"
                    tools:text="Thu Duc, HCM" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider" />

        <!-- ===== FOOTER: Ngày tạo + action icons ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCreatedIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/cd_created_date"
                android:src="@drawable/calendar"
                app:tint="@color/vip_purple" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCreatedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_created_date"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/label_text_size" />

                <TextView
                    android:id="@+id/tvCreatedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/label_text_size"
                    tools:text="18/06/2026 10:35 PM" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/action_buttons_height"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnView"
                    android:layout_width="@dimen/action_icon_size"
                    android:layout_height="@dimen/action_icon_size"
                    android:background="@color/white"
                    android:contentDescription="@string/cd_view_account"
                    android:padding="7dp"
                    android:src="@drawable/eye"
                    app:tint="@color/brand_blue" />

                <ImageView
                    android:id="@+id/btnEdit"
                    android:layout_width="@dimen/action_icon_size"
                    android:layout_height="@dimen/action_icon_size"
                    android:layout_marginStart="@dimen/sp_8"
                    android:background="@color/white"
                    android:contentDescription="@string/cd_edit_account"
                    android:padding="10dp"
                    android:src="@drawable/edit2"
                    app:tint="@color/brand_blue" />

                <ImageView
                    android:id="@+id/btnDelete"
                    android:layout_width="@dimen/action_icon_size"
                    android:layout_height="@dimen/action_icon_size"
                    android:layout_marginStart="@dimen/sp_8"
                    android:background="@color/white"
                    android:contentDescription="@string/cd_delete_account"
                    android:padding="10dp"
                    android:src="@drawable/trash_can"
                    app:tint="@color/danger_dark" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>