<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_baby_blue"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.OrderDetails">

    <!-- ── Header bar ─────────────────────────────────────────────────────── -->
    <include
        android:id="@+id/headerBar"
        layout="@layout/layout_client_subpage_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Scrollable content ─────────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="36dp">

            <!-- ══ Card 1: Order Header ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOrderHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top row: thumbnail + meta + status badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Thumbnail -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EFF6FF">

                            <ImageView
                                android:id="@+id/ivOrderThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@mipmap/logo_ngo_gia"
                                android:contentDescription="@null" />

                        </androidx.cardview.widget.CardView>

                        <!-- Order meta (takes remaining width) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Order ID + status badge row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvDetailOrderId"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="@font/inter_semibold"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    tools:text="#HTNG-70969" />

                                <TextView
                                    android:id="@+id/tvDetailStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:drawablePadding="4dp"
                                    tools:text="Pending"
                                    tools:background="@drawable/bg_status_pending" />

                            </LinearLayout>

                            <!-- Date -->
                            <TextView
                                android:id="@+id/tvDetailDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="3dp"
                                tools:text="25 Jun 2026 • 08:14 AM" />

                            <!-- Payment chip -->
                            <TextView
                                android:id="@+id/tvPaymentChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="3dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_payment_chip"
                                android:textColor="#1E40AF"
                                tools:text="Cash on hand" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Stats row: items count + total — each half width -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ITEMS"
                                android:fontFamily="@font/inter_family"
                                android:letterSpacing="0.08"
                                android:textColor="@color/secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDetailItemCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/inter_semibold"
                                android:layout_marginTop="2dp"
                                tools:text="3 items" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:background="#E5E7EB" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL"
                                android:fontFamily="@font/inter_family"
                                android:letterSpacing="0.08"
                                android:textColor="@color/secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDetailTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/brand_blue"
                                android:fontFamily="@font/inter_semibold"
                                android:layout_marginTop="2dp"
                                tools:text="64.000đ" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Address (shown only when customerAddress non-empty) -->
                    <View
                        android:id="@+id/vAddressDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llDetailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginTop="2dp"
                            android:src="@drawable/ic_location_on"
                            android:contentDescription="@null"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvDetailAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="2dp"
                            tools:text="H071 - 244 Duong So 8, Linh Xuan, Thu Duc, HCMC" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Delivery Information ═════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_family"
                android:letterSpacing="0.08"
                android:text="@string/str_section_delivery_info"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_customer_name" />
                        <TextView
                            android:id="@+id/tvDeliveryName"
                            style="@style/OrderDetailInfoValue"
                            tools:text="Nguyễn Hoàng Đức" />
                    </LinearLayout>
                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView style="@style/OrderDetailInfoLabel" android:text="@string/str_label_phone_number" />
                        <TextView android:id="@+id/tvDeliveryPhone" style="@style/OrderDetailInfoValue" tools:text="033 643 349" />
                    </LinearLayout>
                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView style="@style/OrderDetailInfoLabel" android:text="@string/str_label_delivery_address" />
                        <TextView android:id="@+id/tvDeliveryAddress" style="@style/OrderDetailInfoValue"
                            android:maxLines="4"
                            android:ellipsize="none"
                            tools:text="H071 - 244 Duong So 8, Linh Xuan, Thu Duc, HCMC" />
                    </LinearLayout>
                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView style="@style/OrderDetailInfoLabel" android:text="@string/str_label_payment_method" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/tvDeliveryPayment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:background="@drawable/bg_payment_momo"
                                tools:text="MoMo" />
                        </FrameLayout>
                    </LinearLayout>
                    <View style="@style/OrderDetailRowDivider" />

                    <LinearLayout style="@style/OrderDetailInfoRow">
                        <TextView
                            style="@style/OrderDetailInfoLabel"
                            android:text="@string/str_label_order_status" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/tvDeliveryStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:background="@drawable/bg_status_pending"
                                tools:text="Pending" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Order Items (cart-style cards) ═════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_family"
                android:letterSpacing="0.08"
                android:text="@string/str_section_order_items"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ══ Payment Summary (copy cart cardOrderSummary) ═══════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7EDF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="@string/cart_subtotal"
                            android:textColor="@color/secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaySubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="@string/cart_delivery_fee"
                            android:textColor="@color/secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayShipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="0đ"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="@string/cart_voucher"
                            android:textColor="@color/secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:fontWeight="800"
                            android:text="0đ"
                            android:textColor="@color/phone_green"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPayTotalLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:fontWeight="800"
                            android:text="@string/cart_total"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:fontWeight="800"
                            android:textColor="@color/brand_blue"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0đ" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/llTwoActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeftAction"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/inter_family"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="10dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/brand_blue"
                    app:cornerRadius="24dp"
                    app:elevation="2dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white"
                    tools:icon="@drawable/ic_location_on"
                    tools:text="Track Order" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRightAction"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_family"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="10dp"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="24dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_blue"
                    app:strokeColor="@color/brand_blue"
                    app:strokeWidth="1.5dp"
                    tools:icon="@drawable/headphones"
                    tools:text="Contact Support" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSingleAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSingleAction"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:fontFamily="@font/inter_family"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="16dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/brand_blue"
                    app:cornerRadius="24dp"
                    app:elevation="2dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white"
                    tools:icon="@drawable/ic_reorder_order_detail"
                    tools:text="Order Again" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvActionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
