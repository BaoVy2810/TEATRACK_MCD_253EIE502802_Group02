<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/order_item_padding_v"
    android:paddingBottom="@dimen/order_item_padding_v">

    <FrameLayout
        android:layout_width="@dimen/order_icon_size"
        android:layout_height="@dimen/order_icon_size"
        android:layout_marginEnd="@dimen/sp_12"
        android:background="@drawable/bg_order_icon_wrap">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/cart" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOrderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/order_item_gap"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/order_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/order_subtitle_size" />

    </LinearLayout>

</LinearLayout>
