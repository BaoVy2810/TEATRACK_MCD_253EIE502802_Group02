<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/chatbot_title"
        android:scaleType="centerCrop"
        android:src="@mipmap/admin_avatar"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TeaTrack.Circle"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bot_bubble"
        android:fontFamily="@font/inter"
        android:justificationMode="inter_word"
        android:maxWidth="260dp"
        android:padding="12dp"
        android:text="@string/chatbot_welcome"
        android:textAlignment="viewStart"
        android:textColor="@color/brand_blue"
        android:textSize="14sp" />

</LinearLayout>
