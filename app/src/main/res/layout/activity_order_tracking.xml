<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.OrderTracking">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/product_detail_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_tracking_title"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/order_tracking_sample_id"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Map Placeholder -->
            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="#E0E0E0">

                <!-- Placeholder for actual Google Maps Fragment -->
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/str_agency_location"
                    android:src="@drawable/location"
                    app:tint="#808080" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/delivery" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtShipperStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_tracking_shipper_status"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtEstimatedTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_tracking_estimated_sample"
                                android:textColor="#666666"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Order Status Stepper -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/order_tracking_status_title"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Stepper Item 1 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/dot1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stepper_dot_active" />

                        <View
                            android:id="@+id/line1"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:layout_below="@id/dot1"
                            android:layout_centerHorizontal="false"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_stepper_line" />

                        <TextView
                            android:id="@+id/txtStatusConfirmed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot1"
                            android:text="@string/order_tracking_confirmed"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/txtStatusConfirmed"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot1"
                            android:text="@string/order_tracking_sample_time1"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Stepper Item 2 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/dot2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stepper_dot_active" />

                        <View
                            android:id="@+id/line2"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:layout_below="@id/dot2"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_stepper_line" />

                        <TextView
                            android:id="@+id/txtStatusPreparing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot2"
                            android:text="@string/order_tracking_preparing"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/txtStatusPreparing"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot2"
                            android:text="@string/order_tracking_sample_time2"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Stepper Item 3: Ready for Pickup -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/dot3"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stepper_dot" />

                        <View
                            android:id="@+id/line3"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:layout_below="@id/dot3"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_stepper_line" />

                        <TextView
                            android:id="@+id/txtStatusReady"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot3"
                            android:text="@string/order_tracking_ready_for_pickup"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/txtStatusReady"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot3"
                            android:text="@string/order_tracking_waiting_pickup"
                            android:textColor="#999999"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Stepper Item 4 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/dot4"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stepper_dot" />

                        <View
                            android:id="@+id/line4"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:layout_below="@id/dot4"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_stepper_line" />

                        <TextView
                            android:id="@+id/txtStatusDelivery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot4"
                            android:text="@string/order_tracking_out_for_delivery"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/txtStatusDelivery"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot4"
                            android:text="@string/order_tracking_waiting_shipper"
                            android:textColor="#999999"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Stepper Item 5 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/dot5"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stepper_dot" />

                        <TextView
                            android:id="@+id/txtStatusDelivered"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/dot5"
                            android:text="@string/order_tracking_delivered"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Delivery Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:text="@string/order_tracking_delivery_info"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_info" /><!-- Thay ic_order_info bằng tên file icon của bạn -->
                        <!-- Căn cho icon và chữ thẳng hàng nhau theo chiều dọc -->/>

                    <!-- Recipient -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_recipient"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/txtRecipient"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_dummy_name"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_address"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/txtAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/personal_info_dummy_address"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>

                    <!-- Payment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_payment"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/txtPayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_cash"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contact Support Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactSupport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/order_tracking_contact_support"
                android:textAllCaps="false"
                android:textColor="#0088FF"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/calling"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#0088FF"
                app:strokeColor="#0088FF" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>