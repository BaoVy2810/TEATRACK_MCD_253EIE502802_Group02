<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.OrderTracking">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/product_detail_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_tracking_title"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/order_tracking_sample_id"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Map Placeholder -->
            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="#E0E0E0">

                <WebView
                    android:id="@+id/webViewMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/delivery" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtShipperStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_tracking_shipper_status"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtEstimatedTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_tracking_estimated_sample"
                                android:textColor="#666666"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Order Status Stepper -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:text="@string/order_tracking_status_title"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- New Horizontal Stepper Structure -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- TẦNG 1: Circle row + Lines (Fixed height 56dp) -->
                        <LinearLayout
                            android:id="@+id/circleRow"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Spacer for alignment (Weight 0.5) -->
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="0.5" />

                            <FrameLayout
                                android:id="@+id/stepCircle1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg1"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/pending"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#4CAF50"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg2"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/processing"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#4CAF50"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg3"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ready"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#4CAF50"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg4"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/shipping"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="3dp"
                                android:layout_weight="1"
                                android:background="#E0E0E0">

                                <View
                                    android:id="@+id/stepLine4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#4CAF50"
                                    android:scaleX="0"
                                    android:transformPivotX="0dp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/stepCircle5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_step_circle_inactive">

                                <ImageView
                                    android:id="@+id/stepImg5"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/finished"
                                    app:tint="#BDBDBD" />
                            </FrameLayout>

                            <!-- Spacer for alignment (Weight 0.5) -->
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="0.5" />
                        </LinearLayout>

                        <!-- TẦNG 2: Label row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/circleRow"
                            android:layout_marginTop="4dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/stepLabel1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_pending"
                                android:textColor="#999999"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/stepLabel2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_processing"
                                android:textColor="#999999"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/stepLabel3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_ready"
                                android:textColor="#999999"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/stepLabel4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_shipping"
                                android:textColor="#999999"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/stepLabel5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/order_tracking_completed"
                                android:textColor="#999999"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Delivery Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/order_tracking_delivery_info"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_info" />

                    <!-- Recipient -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_recipient"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/txtRecipient"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_dummy_name"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_address"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/txtAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/personal_info_dummy_address"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>

                    <!-- Payment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_payment"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/txtPayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/order_tracking_cash"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contact Support Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactSupport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/order_tracking_contact_support"
                android:textAllCaps="false"
                android:textColor="#0088FF"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/calling"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#0088FF"
                app:strokeColor="#0088FF" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>