<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.OrderHistory">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="4dp"
        app:liftOnScroll="false">

        <!-- Client header: logo + cart + profile -->
        <include
            android:id="@+id/headerClient"
            layout="@layout/activity_header_client" />

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="20dp"
                android:text="@string/str_my_orders"
                android:textColor="@color/brand_blue"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- Search bar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:paddingTop="4dp"
            android:gravity="center_vertical">

            <!-- Search card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F3F4F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/search"
                        android:importantForAccessibility="no"
                        app:tint="@color/brand_blue" />

                    <EditText
                        android:id="@+id/etSearchOrder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/str_search_order_hint"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/placeholder"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Status tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/llStatusTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Tab: All -->
                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_order_tab_active"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_all"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab: Pending -->
                <TextView
                    android:id="@+id/tabPending"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_order_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_pending"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:drawablePadding="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab: Preparing Order -->
                <TextView
                    android:id="@+id/tabProcessing"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_order_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_processing"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab: Ready -->
                <TextView
                    android:id="@+id/tabReady"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_order_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab: Out for Delivery -->
                <TextView
                    android:id="@+id/tabShipping"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_order_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_shipping"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab: Delivered -->
                <TextView
                    android:id="@+id/tabDelivered"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_order_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_delivered"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab: Cancelled -->
                <TextView
                    android:id="@+id/tabCancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_order_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/str_tab_cancelled"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Order list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="90dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                tools:listitem="@layout/item_order_history_card" />

            <!-- Loading skeleton -->
            <LinearLayout
                android:id="@+id/layoutSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone">

                <!-- Skeleton card 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="#F3F4F6" android:alpha="0.6"/>
                </androidx.cardview.widget.CardView>

                <!-- Skeleton card 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="#F3F4F6" android:alpha="0.6"/>
                </androidx.cardview.widget.CardView>

                <!-- Skeleton card 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="#F3F4F6" android:alpha="0.6"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/bag1"
                    android:contentDescription="@null"
                    android:alpha="0.25"
                    app:tint="@color/brand_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/str_no_orders"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/str_no_orders_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Navigation Bar Client -->
    <include
        android:id="@+id/layout_nav_bar"
        layout="@layout/activity_nav_bar_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
