<?xml version="1.0" encoding="utf-8"?>
<!--
    item_stat_card.xml
    Gradient background được set programmatically trong Java.
    Tất cả text được bind từ AdminDashboard.java — không hardcode.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/stat_card_corner"
    app:cardElevation="@dimen/stat_card_elevation"
    app:cardBackgroundColor="@color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="140dp">

        <!-- Gradient background view (tinted programmatically) -->
        <View
            android:id="@+id/viewStatBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Decorative translucent circle (top-right) -->
        <View
            android:layout_width="@dimen/stat_circle_overlay_size"
            android:layout_height="@dimen/stat_circle_overlay_size"
            android:layout_gravity="top|end"
            android:layout_marginTop="-24dp"
            android:layout_marginEnd="-24dp"
            android:background="@drawable/bg_stat_circle"
            android:importantForAccessibility="no" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/stat_card_padding">

            <!-- Icon wrap + title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/sp_8">

                <!-- White circle icon wrap -->
                <FrameLayout
                    android:layout_width="@dimen/stat_icon_wrap_size"
                    android:layout_height="@dimen/stat_icon_wrap_size"
                    android:background="@drawable/bg_stat_icon_wrap"
                    android:layout_marginEnd="@dimen/sp_8">

                    <ImageView
                        android:id="@+id/ivStatIcon"
                        android:layout_width="@dimen/stat_icon_size"
                        android:layout_height="@dimen/stat_icon_size"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <!-- Title label (e.g. REVENUE) -->
                <TextView
                    android:id="@+id/tvStatTitle"
                    style="@style/TextAppearance.TeaTrack.StatTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Big value (e.g. 1.013.200đ) -->
            <TextView
                android:id="@+id/tvStatValue"
                style="@style/TextAppearance.TeaTrack.StatValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sp_8"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Bottom row: ↑ +5.2% MoM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Trend icon -->
                <ImageView
                    android:id="@+id/ivTrendIcon"
                    android:layout_width="@dimen/stat_delta_icon_size"
                    android:layout_height="@dimen/stat_delta_icon_size"
                    android:src="@drawable/up"
                    android:layout_marginEnd="@dimen/sp_4"
                    app:tint="@color/white"
                    android:importantForAccessibility="no" />

                <!-- Delta % (e.g. +5.2%) -->
                <TextView
                    android:id="@+id/tvStatDelta"
                    style="@style/TextAppearance.TeaTrack.StatDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!-- Label suffix (e.g. " MoM" or "Active trading") -->
                <TextView
                    android:id="@+id/tvStatLabel"
                    style="@style/TextAppearance.TeaTrack.StatDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/sp_4" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>