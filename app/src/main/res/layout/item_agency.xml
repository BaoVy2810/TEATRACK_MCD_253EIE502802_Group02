<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAgency"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAgency"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImageView"
            android:src="@mipmap/logo_ngo_gia"
            android:contentDescription="Agency Image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAgencyId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: CN01"
                android:textColor="#666666"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_family" />

            <TextView
                android:id="@+id/tvAgencyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Tên chi nhánh"
                android:textColor="#0088FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_family" />

            <TextView
                android:id="@+id/tvAgencyAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Địa chỉ chi nhánh"
                android:textColor="#1A1A1A"
                android:textSize="10sp"
                android:fontFamily="@font/inter_family" />

            <TextView
                android:id="@+id/tvAgencyPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SĐT: 0123456789"
                android:textColor="#1A1A1A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_family" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnVisibility"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/eye"
                app:tint="#0088FF"
                android:contentDescription="Visibility Toggle" />

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/edit2"
                app:tint="#0088FF"
                android:contentDescription="Edit" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/trash_can"
                app:tint="#FF4444"
                android:contentDescription="Delete" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>