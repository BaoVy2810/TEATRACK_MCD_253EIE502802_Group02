<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_baby_blue"
    tools:context=".client.MyReviewsActivity">

    <ImageView
        android:id="@+id/btnProfileBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_profile_back_button"
        android:contentDescription="@string/product_detail_back"
        android:elevation="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/uspro_bg"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="180dp"
                android:fontFamily="@font/inter_family"
                android:text="@string/reviews_title"
                android:textColor="#1A1A2E"
                android:textSize="32sp"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="1"

                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle">

                <!-- Review 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStore1Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/history_dummy_store1_name"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            app:layout_constraintEnd_toStartOf="@id/tvReview1Date"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvReview1Date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_date1"
                            android:textColor="@color/Gray"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvStore1Name" />

                        <LinearLayout
                            android:id="@+id/llStars1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStore1Name">

                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_content1"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            app:layout_constraintTop_toBottomOf="@id/llStars1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Review 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStore2Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/history_dummy_store2_name"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            app:layout_constraintEnd_toStartOf="@id/tvReview2Date"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvReview2Date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_date2"
                            android:textColor="@color/Gray"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvStore2Name" />

                        <LinearLayout
                            android:id="@+id/llStars2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStore2Name">

                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/empstar" app:tint="@color/Gray" android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_content2"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            app:layout_constraintTop_toBottomOf="@id/llStars2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Review 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStore3Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/history_dummy_store3_name"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            app:layout_constraintEnd_toStartOf="@id/tvReview3Date"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvReview3Date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_date3"
                            android:textColor="@color/Gray"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvStore3Name" />

                        <LinearLayout
                            android:id="@+id/llStars3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStore3Name">

                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_content3"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            app:layout_constraintTop_toBottomOf="@id/llStars3" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Review 4 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStore4Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/history_dummy_store4_name"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            app:layout_constraintEnd_toStartOf="@id/tvReview4Date"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvReview4Date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_date4"
                            android:textColor="@color/Gray"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvStore4Name" />

                        <LinearLayout
                            android:id="@+id/llStars4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStore4Name">

                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/fullstar" app:tint="@color/brand_blue" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/empstar" app:tint="@color/Gray" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/empstar" app:tint="@color/Gray" android:contentDescription="@null" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/empstar" app:tint="@color/Gray" android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/inter_family"
                            android:text="@string/reviews_dummy_content4"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            app:layout_constraintTop_toBottomOf="@id/llStars4" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="147dp"
                android:layout_height="92dp"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/login_logo_description"
                android:scaleType="fitXY"
                android:src="@mipmap/logo_ngo_gia"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.909"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>