<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="52dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_category_dialog"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:minHeight="220dp"
        android:paddingStart="12dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Close"
            android:elevation="4dp"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/imgCategoryHero"
            android:layout_width="170dp"
            android:layout_height="250dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="-72dp"
            android:contentDescription="Category hero product"
            android:elevation="6dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/tra_yakult" />

        <ImageView
            android:id="@+id/btnPrevProduct"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_arrow_circle"
            android:contentDescription="Previous"
            android:elevation="2dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_left"
            app:layout_constraintBottom_toBottomOf="@id/rvCategoryProducts"
            app:layout_constraintStart_toEndOf="@id/imgCategoryHero"
            app:layout_constraintTop_toTopOf="@id/rvCategoryProducts"
            app:tint="@color/brand_blue" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryProducts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:clipToPadding="false"
            android:minHeight="170dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnNextProduct"
            app:layout_constraintStart_toEndOf="@id/btnPrevProduct"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/item_category_product" />

        <ImageView
            android:id="@+id/btnNextProduct"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_arrow_circle"
            android:contentDescription="Next"
            android:elevation="2dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_right"
            app:layout_constraintBottom_toBottomOf="@id/rvCategoryProducts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/rvCategoryProducts"
            app:tint="@color/brand_blue" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
