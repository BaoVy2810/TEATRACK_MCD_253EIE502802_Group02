<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg"
    android:fillViewport="true"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.FilledOtpActivity"
    tools:device="pixel_4">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:backgroundTint="@color/brand_blue"
            android:contentDescription="@string/previous"
            android:src="@drawable/ic_arrow_left" />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/logo_ngo_gia" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter_family"
            android:gravity="center"
            android:text="@string/otp_title"
            android:textColor="@color/Red"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_family"
            android:gravity="center"
            android:text="@string/otp_subtitle"
            android:textColor="@color/Gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEmailMasked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_family"
            android:gravity="center"
            android:textColor="@color/darkgreen"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="@string/str_email_masked" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="6">

            <EditText
                android:id="@+id/etOtp1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/otp_box_border"
                android:gravity="center"
                android:hint="@string/str_otp"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@android:color/black"
                android:textColorHint="@color/Gray"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/otp_box_border"
                android:gravity="center"
                android:hint="@string/str_otp"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@android:color/black"
                android:textColorHint="@color/Gray"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/otp_box_border"
                android:gravity="center"
                android:hint="@string/str_otp"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@android:color/black"
                android:textColorHint="@color/Gray"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/otp_box_border"
                android:gravity="center"
                android:hint="@string/str_otp"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@android:color/black"
                android:textColorHint="@color/Gray"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/otp_box_border"
                android:gravity="center"
                android:hint="@string/str_otp"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@android:color/black"
                android:textColorHint="@color/Gray"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/otp_box_border"
                android:gravity="center"
                android:hint="@string/str_otp"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@android:color/black"
                android:textColorHint="@color/Gray"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/inter_family"
            android:gravity="center"
            android:text="@string/otp_resend_countdown"
            android:textColor="@color/Gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResendOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_family"
            android:gravity="center"
            android:text="@string/otp_resend"
            android:textColor="@color/darkgreen"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/brand_blue"
            android:enabled="false"
            android:fontFamily="@font/inter_family"
            android:text="@string/otp_verify_btn"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
