<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.FilledOtpActivity">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/login_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_profile_back_button"
                android:clickable="true"
                android:contentDescription="@string/product_detail_back"
                android:elevation="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="184dp"
                android:layout_height="204dp"
                android:layout_gravity="center_horizontal|top"
                android:contentDescription="@string/login_logo_description"
                android:scaleType="fitStart"
                android:src="@mipmap/logo_ngo_gia" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:shadowColor="@color/Red"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:text="@string/otp_title"
                android:textColor="@color/Red"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:text="@string/otp_subtitle"
                android:textColor="@color/Gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmailMasked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="@string/str_email_masked" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:weightSum="6">

                <EditText
                    android:id="@+id/etOtp1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_border"
                    android:gravity="center"
                    android:hint="@string/str_otp"
                    android:importantForAccessibility="yes"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/Gray"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_border"
                    android:gravity="center"
                    android:hint="@string/str_otp"
                    android:importantForAccessibility="yes"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/Gray"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp3"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_border"
                    android:gravity="center"
                    android:hint="@string/str_otp"
                    android:importantForAccessibility="yes"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/Gray"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp4"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_border"
                    android:gravity="center"
                    android:hint="@string/str_otp"
                    android:importantForAccessibility="yes"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/Gray"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp5"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_border"
                    android:gravity="center"
                    android:hint="@string/str_otp"
                    android:importantForAccessibility="yes"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/Gray"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp6"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_border"
                    android:gravity="center"
                    android:hint="@string/str_otp"
                    android:importantForAccessibility="yes"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/Gray"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:text="@string/otp_resend_countdown"
                android:textColor="@color/Gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="@string/otp_resend"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnVerifyOtp"
                android:layout_width="300dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/brand_blue"
                android:enabled="false"
                android:fontFamily="@font/inter_family"
                android:text="@string/otp_verify_btn"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
