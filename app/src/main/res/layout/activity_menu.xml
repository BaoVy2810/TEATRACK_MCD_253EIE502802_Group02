<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_baby_blue"
    tools:context="com.teatrack_mcd_253eie502802_group02.client.Menu">

    <include
        android:id="@+id/headerClient"
        layout="@layout/activity_header_client"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/navBarClient"
        layout="@layout/activity_nav_bar_client"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Banner card (static, does not scroll) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/menuBannerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerClient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EAF4FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_title"
                    android:textColor="@color/brand_dark_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/menu_subtitle"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:justificationMode="inter_word"
                    android:paddingEnd="20dp"
                    android:text="@string/menu_description"
                    android:textColor="@color/Gray"
                    android:textSize="8sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_card_white_20dp"
                android:backgroundTint="@color/white"
                android:contentDescription="@string/menu_hero_image_desc"
                android:scaleType="centerCrop"
                android:src="@mipmap/tra_sua"
                app:shapeAppearanceOverlay="@style/RoundedBanner" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Search bar (static, always visible) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menuSearchCard"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuBannerCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/menu_search_desc"
                android:src="@drawable/search"
                app:tint="@color/brand_blue" />

            <EditText
                android:id="@+id/edtMenuSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:hint="@string/menu_search_hint"
                android:paddingStart="10dp"
                android:textColor="@color/brand_blue"
                android:textColorHint="@color/brand_blue"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnMenuFilter"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_icon_button"
                android:contentDescription="@string/menu_filter_desc"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="7dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/brand_blue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section title + result count row (static) -->
    <LinearLayout
        android:id="@+id/menuSectionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuSearchCard">

        <TextView
            android:id="@+id/tvMenuSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_all_products_title"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMenuSectionSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_section_subtitle_default"
                android:textColor="@color/Gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvMenuResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_promotion_rounded_24"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/menu_result_count_default"
                android:textColor="@color/brand_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!--
        RecyclerView with a DEFINITE height (0dp constrained) so virtualization works.
        Previously inside NestedScrollView → NestedScrollView measured RV with
        MeasureSpec.UNSPECIFIED → all ~50 items inflated at once → 2s+ jank.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMenuProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/navBarClient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuSectionHeader"
        tools:itemCount="6"
        tools:listitem="@layout/item_menu_product_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
