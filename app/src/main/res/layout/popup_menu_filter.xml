<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="192dp"
    android:layout_height="wrap_content"
    android:maxHeight="340dp"
    android:background="@drawable/bg_filter_panel"
    android:elevation="12dp"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_filter_category_title"
        android:textAllCaps="true"
        android:textColor="#8E93A1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/optCategoryAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@android:color/transparent"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/menu_all_categories"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optCategoryPureTea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/firebase_category_pure_tea"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optCategoryMilkTea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/firebase_category_milk_tea"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optCategoryTeaLatte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/firebase_category_tea_latte"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optCategoryFruitTea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/firebase_category_fruit_tea"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optCategoryNewArrivals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/firebase_category_new_arrivals"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optCategoryBestSellers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/firebase_category_best_sellers"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#14000000" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_filter_sort_title"
        android:textAllCaps="true"
        android:textColor="#8E93A1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/optSortFeatured"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/menu_sort_featured"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optSortNameAsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/menu_sort_name_asc"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optSortNameDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/menu_sort_name_desc"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optSortPriceAsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/menu_sort_price_asc"
        android:textColor="#252B37"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optSortPriceDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/menu_sort_price_desc"
        android:textColor="#252B37"
        android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
