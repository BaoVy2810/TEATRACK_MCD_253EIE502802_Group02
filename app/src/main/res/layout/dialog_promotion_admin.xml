<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_modal_padding">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/admin_modal_header_gap">

                <TextView
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/btnCloseDialog"
                    android:text="@string/str_promotion_details"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseDialog"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_input_rounded"
                    android:contentDescription="@string/str_close"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/brand_blue" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/admin_modal_divider_gap"
                android:background="@color/divider" />

            <!-- Promotion Code -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_promotion_code"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPromotionCode"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/hint_enter_promotion_code"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="@color/brand_blue"
                android:textColorHint="#0088FF"
                android:textSize="12sp" />

            <!-- Promotion Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_promotion_description"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPromotionDesc"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/hint_enter_promotion_desc"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/brand_blue"
                android:textColorHint="#0088FF"
                android:textSize="12sp" />

            <!-- Promotion Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_promotion_type"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/typeSelectRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_input_rounded"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvTypeSelect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    tools:text="Amount" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="⌃"
                    android:textColor="@color/brand_blue"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Promotion Value -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_promotion_value"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPromotionValue"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/hint_enter_value"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/brand_blue"
                android:textColorHint="#0088FF"
                android:textSize="12sp" />

            <!-- Min Subtotal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_min_subtotal"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMinSubtotal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/hint_enter_min_subtotal"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/brand_blue"
                android:textColorHint="#0088FF"
                android:textSize="12sp" />

            <!-- Max Discount (Optional for Percent) -->
            <TextView
                android:id="@+id/tvMaxDiscountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_max_discount"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etMaxDiscount"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/hint_enter_max_discount"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/brand_blue"
                android:textColorHint="#0088FF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Image Selection Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_image_source"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/toggleImageSource"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:background="@drawable/bg_toggle_group_blue"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnSourceLocal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_toggle_item_active_white"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/str_image_local"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSourceRemote"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_toggle_item_inactive_transparent"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/str_image_remote"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Local Image Picker -->
            <LinearLayout
                android:id="@+id/layoutLocalImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectLocalImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_choose"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/brand_blue"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Remote Image URL -->
            <LinearLayout
                android:id="@+id/layoutRemoteImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etImageUrl"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/hint_enter_image_url"
                    android:inputType="textUri"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/brand_blue"
                    android:textColorHint="#0088FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPromotionPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/admin_modal_field_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                android:contentDescription="@string/str_promotion_preview"
                android:scaleType="centerCrop"
                android:src="@drawable/image"
                app:shapeAppearanceOverlay="@style/RoundedImageView"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />

            <!-- Live Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_promotion_preview"
                android:textColor="@color/brand_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_modal_label_input_gap"
                android:layout_marginBottom="@dimen/admin_modal_field_gap"
                app:cardBackgroundColor="@color/bg_light_gray"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvPreviewTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_promotion_code"
                        android:textColor="@color/brand_blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_preview_discount"
                        android:textColor="@color/danger"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPreviewMinOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_preview_min_order"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Status -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swPromotionActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Active"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:thumbTint="@color/switch_thumb_brand"
                app:trackTint="@color/switch_track_brand" />

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_modal_actions_gap"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelPromotion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/danger"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/btn_cancel"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePromotion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/brand_blue"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/btn_save"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/edit2"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>
