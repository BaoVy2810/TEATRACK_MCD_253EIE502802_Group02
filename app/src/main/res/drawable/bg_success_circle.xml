<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vòng ngoài xanh nhạt -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A0088FF" />
            <size android:width="100dp" android:height="100dp" />
        </shape>
    </item>

    <!-- Vòng trong xanh đậm -->
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="#0088ff" />
        </shape>
    </item>

    <!-- Dấu tick trắng -->
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp"
        android:drawable="@drawable/ic_check_white" />

</layer-list>